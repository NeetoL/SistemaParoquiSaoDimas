@model GestaoDetalhesViewModel
@{ViewData["Title"]=Model.Modulo.Nome;ViewData["Descricao"]="Detalhes do registro";}
<section class="card"><div class="card-header"><h2 class="card-title">Registro @(Model.Registro.Cancelado?"cancelado":"ativo")</h2><span class="badge badge-neutral">Revisão @Model.Registro.Revisao</span></div><div class="card-body"><dl class="lista-dados">@foreach(var c in Model.Modulo.Campos){<div><dt>@c.Nome</dt><dd>@Model.Exibir(c)</dd></div>}<div><dt>Identificador para importações</dt><dd class="break-all">@Model.Registro.Id</dd></div><div><dt>Cadastrado por</dt><dd>@Model.Registro.CriadoPor</dd></div></dl></div><div class="card-footer flex-wrap"><a href="/Gestao/@Model.Modulo.Chave" class="btn btn-outline">Voltar</a><a href="/Gestao/@Model.Modulo.Chave/@Model.Registro.Id/Documento" class="btn btn-secondary">@(Model.Modulo.Chave=="contribuicoes"?"Emitir recibo":Model.Modulo.Chave=="sacramentos"?"Emitir certidão":"Documento PDF")</a>@if(Model.Registro.AnexoBase64 is not null){<a href="/Gestao/@Model.Modulo.Chave/@Model.Registro.Id/Comprovante" class="btn btn-outline">Baixar comprovante</a>}@if(!Model.Registro.Cancelado&&Model.Modulo.Chave is not ("financeiro" or "contribuicoes")){<a href="/Gestao/@Model.Modulo.Chave/@Model.Registro.Id/Editar" class="btn btn-primary">Editar</a>}</div></section>
@if(!Model.Registro.Cancelado){<details class="card mt-6 p-5"><summary class="text-danger-700 cursor-pointer">Cancelar registro</summary><p class="text-muted mt-3 mb-3">O registro deixa de participar das listagens e dos totais. O histórico é preservado.</p><form action="/Gestao/@Model.Modulo.Chave/@Model.Registro.Id/Cancelar" method="post">@Html.AntiForgeryToken()<input name="revisao" type="hidden" value="@Model.Registro.Revisao" /><button class="btn btn-danger">Confirmar cancelamento</button></form></details>}
