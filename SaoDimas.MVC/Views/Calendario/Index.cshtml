@{ ViewData["Title"] = "Calendário da fé"; ViewData["Descricao"] = "Celebrações do Brasil e a memória dos santos, dia após dia."; }

<div data-calendario class="calendario-layout" aria-busy="true">
    <section class="calendario-mes" aria-label="Calendário mensal">
        <div class="calendario-toolbar"><div class="calendario-periodo"><label class="sr-only" for="calendario-mes">Mês</label><select id="calendario-mes" class="form-control"></select><label class="sr-only" for="calendario-ano">Ano</label><input id="calendario-ano" class="form-control" type="number" min="2000" max="2100" step="1" /></div><div class="flex gap-1"><button type="button" class="btn btn-ghost btn-icone" data-calendario-anterior aria-label="Mês anterior"><svg class="icone" aria-hidden="true"><use href="/icons/lucide.svg#chevron-left" /></svg></button><button type="button" class="btn btn-outline btn-sm" data-calendario-hoje>Hoje</button><button type="button" class="btn btn-ghost btn-icone" data-calendario-proximo aria-label="Próximo mês"><svg class="icone" aria-hidden="true"><use href="/icons/lucide.svg#chevron-right" /></svg></button></div></div>
        <div class="calendario-busca form-field"><label for="calendario-busca" class="form-label">Buscar santo ou celebração neste ano</label><div class="flex gap-2"><input id="calendario-busca" type="search" class="form-control" placeholder="Ex.: São José, Aparecida, Páscoa…" /><button type="button" class="btn btn-ghost btn-sm" data-calendario-limpar hidden>Limpar</button></div></div>
        <p class="calendario-aviso" data-calendario-aviso role="status" aria-live="polite">Preparando o calendário…</p>
        <div class="calendario-semana" aria-hidden="true"><span>DOM</span><span>SEG</span><span>TER</span><span>QUA</span><span>QUI</span><span>SEX</span><span>SÁB</span></div>
        <div class="calendario-grade" data-calendario-grade></div>
        <div class="calendario-resultados" data-calendario-resultados hidden></div>
        <div class="calendario-legenda"><span><i class="liturgia-cor cor-white"></i>Branco</span><span><i class="liturgia-cor cor-red"></i>Vermelho</span><span><i class="liturgia-cor cor-purple"></i>Roxo</span><span><i class="liturgia-cor cor-green"></i>Verde</span><span><i class="liturgia-cor cor-rose"></i>Rosa</span></div>
    </section>
    <aside class="calendario-dia" aria-label="Detalhes do dia selecionado"><div data-calendario-detalhes aria-live="polite" aria-atomic="true"><p class="text-muted">Selecione um dia para conhecer suas celebrações.</p></div><a data-martirologio class="btn btn-outline w-full" href="https://liturgia.pt/martirologio/" target="_blank" rel="noopener noreferrer">Martirológio completo <svg class="icone" aria-hidden="true"><use href="/icons/lucide.svg#external-link" /></svg></a><p class="calendario-nota">O Martirológio reúne outros santos e beatos que podem não ter celebração no calendário litúrgico.</p></aside>
</div>
<details class="calendario-fontes"><summary>Fontes e abrangência do calendário</summary><p>Calendário Romano Geral e próprio do Brasil, em português, com solenidades, festas, memórias e memórias facultativas. As celebrações móveis e as transferências nacionais são calculadas para o ano escolhido (2000 a 2100). O calendário diocesano e a festa do padroeiro podem ter particularidades locais.</p><p>Dados: <a href="https://github.com/romcal/romcal" target="_blank" rel="noopener noreferrer">Romcal</a>, com regras nacionais conferidas em publicações da <a href="https://www.cnbb.org.br/missal-romano-calendario-proprio-dos-santos-brasil/" target="_blank" rel="noopener noreferrer">CNBB</a>. Consulta ampliada: <a href="https://liturgia.pt/martirologio/" target="_blank" rel="noopener noreferrer">Martirológio Romano · Secretariado Nacional de Liturgia</a>.</p><p>As bibliotecas ficam no próprio sistema. Apenas a consulta ao Martirológio abre um site externo.</p></details>
@section Scripts { <script type="module" src="~/js/calendario.js" asp-append-version="true"></script> }
