@model SaoDimas.Aplicacao.Dtos.RifaDto
@{Layout=null;}
<!DOCTYPE html><html lang="pt-BR"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>Bilhetes — @Model.Nome</title><style>body{font:14px Arial,sans-serif;color:#111;margin:20px}button{padding:12px}article{border:1px dashed #555;padding:16px;margin:16px 0;break-inside:avoid}h1{font-size:20px}h2{font-size:24px}p{margin:8px 0}@@media print{button{display:none}body{margin:0}@@page{size:A4;margin:12mm}}</style></head><body><button onclick="window.print()">Imprimir bilhetes</button>@if(Model.Numeros.Count==0){<p>Não há números reservados para imprimir.</p>}@foreach(var n in Model.Numeros.OrderBy(n=>n.Numero)){<article><h1>@Model.Nome</h1><h2>Número @n.Numero.ToString("D4")</h2><p>Comprador: @n.Comprador</p><p>Valor: @Model.Valor.ToString("C") · @(n.Pago?"Pago":"Pagamento pendente")</p><p>Sorteio: @Model.DataSorteio.ToString("dd/MM/yyyy")</p><p>Prêmios:</p><ol>@foreach(var premio in Model.Premios.Split('\n')){<li>@premio</li>}</ol><p>Vendedor: @n.Vendedor</p></article>}</body></html>
