@model RifaDetalhesViewModel
@{var r=Model.Rifa;var pagos=r.Numeros.Count(n=>n.Pago);var reservados=r.Numeros.Count-pagos;var ocupados=r.Numeros.ToDictionary(n=>n.Numero);var aberta=r.Situacao=="Aberta";var alteravel=r.Situacao is "Aberta" or "Fechada";ViewData["Title"]=r.Nome;ViewData["Descricao"]="Sorteio em "+r.DataSorteio.ToString("dd/MM/yyyy")+" · "+Model.Comunidades.FirstOrDefault(c=>c.Id==r.ComunidadeId)?.Nome+" · "+r.Situacao;}
@section Scripts {<script type="module" src="~/js/rifas.js" asp-append-version="true"></script>}
@section Breadcrumb {<li><a asp-action="Index">Rifas</a></li><li>@r.Nome</li>}
@section Acoes {<button type="button" data-modal-abrir="modal-rifa-pdf" class="btn btn-primary">Baixar bilhetes PDF</button><a asp-action="Exportar" asp-route-id="@r.Id" class="btn btn-outline">Exportar CSV</a><a asp-action="Imprimir" asp-route-id="@r.Id" target="_blank" rel="noopener" class="btn btn-outline">Imprimir bilhetes</a>}
<dialog id="modal-rifa-pdf" class="modal max-w-lg" aria-labelledby="rifa-pdf-titulo">
<form method="get" asp-action="Pdf" class="p-6"><input type="hidden" name="id" value="@r.Id"/>
<h2 id="rifa-pdf-titulo" class="text-lg font-semibold">Bilhetes da rifa em PDF</h2>
<p class="ui-formulario-nota mb-5">Até seis bilhetes por folha A4, com canhoto para a organização. Textos longos usam mais espaço para preservar as informações. Inclui números disponíveis e reservados.</p>
<div class="grid gap-4 md:grid-cols-2"><div class="form-field"><label for="pdf-inicio" class="form-label">Do número</label><input id="pdf-inicio" name="inicio" type="number" min="1" max="@r.Quantidade" value="1" class="form-control" required/></div>
<div class="form-field"><label for="pdf-fim" class="form-label">Até o número</label><input id="pdf-fim" name="fim" type="number" min="1" max="@r.Quantidade" value="@r.Quantidade" class="form-control" required/></div></div>
<p class="ui-formulario-nota mt-4">Para todos os bilhetes, mantenha o intervalo completo. Imprima em tamanho real (100%).</p>
<div class="mt-6 flex justify-end gap-2"><button type="button" data-modal-fechar class="btn btn-outline">Cancelar</button><button class="btn btn-primary">Gerar PDF</button></div></form></dialog>
@if(Model.Erro is not null){<div class="alerta-erro" role="alert">@Model.Erro</div>}
<div class="rifa-resumo">
<section class="rifa-indicador"><span class="text-muted">Números disponíveis</span><strong>@(r.Quantidade-r.Numeros.Count)</strong><span class="text-muted">de @r.Quantidade números</span></section>
<section class="rifa-indicador"><span class="text-muted">Reservados / pagos</span><strong>@reservados <span class="rifa-indicador-separador">/</span> @pagos</strong><progress value="@r.Numeros.Count" max="@r.Quantidade" aria-label="Números reservados e pagos"></progress></section>
<section class="rifa-indicador"><span class="text-muted">Valor recebido</span><strong>@((pagos*r.Valor).ToString("C"))</strong><span class="text-muted">@((reservados*r.Valor).ToString("C")) pendente · @r.Valor.ToString("C") por número</span></section>
</div>
<div class="rifa-operacao">
<aside class="rifa-lateral">
<section class="rifa-painel"><h2>Prêmios e sorteio</h2><p class="text-muted">@r.DataSorteio.ToString("dd/MM/yyyy") · @r.Situacao</p><ol class="rifa-premios">@foreach(var premio in r.Premios.Split('\n')){<li>@premio</li>}</ol>
@foreach(var resultado in r.Resultados.OrderBy(x=>x.Premio)){<p><strong>@resultado.Premio º prêmio: @resultado.Numero.ToString("D4") — @resultado.Comprador</strong><br/><span class="text-sm text-muted">@resultado.Referencia</span></p>}</section>
@if(aberta){<form method="post" asp-action="Reservar" class="ui-folha rifa-reserva"><input type="hidden" name="id" value="@r.Id"/><input type="hidden" name="revisao" value="@r.Revisao"/><fieldset class="ui-formulario-secao"><legend>Reservar números</legend><div class="grid gap-4"><div class="form-field"><label for="numeros" class="form-label">Números *</label><input id="numeros" name="numeros" value="@Model.ReservaNumeros" class="form-control" required placeholder="Ex.: 1, 7, 25"/><p class="ui-formulario-nota">Até 100 por reserva. Clique nos números livres do mapa ou digite aqui.</p></div><div class="form-field"><label for="comprador" class="form-label">Comprador *</label><input id="comprador" name="comprador" value="@Model.Comprador" class="form-control" required maxlength="150"/></div><div class="form-field"><label for="telefone" class="form-label">Telefone</label><input id="telefone" name="telefone" value="@Model.Telefone" type="tel" class="form-control" maxlength="40"/></div><div class="form-field"><label for="vendedor" class="form-label">Vendedor / responsável</label><input id="vendedor" name="vendedor" value="@Model.Vendedor" class="form-control" maxlength="150"/></div></div></fieldset><button class="btn btn-primary">Reservar números</button></form>}
</aside><section class="rifa-painel rifa-mapa-painel" aria-labelledby="rifa-mapa-titulo">
<div class="rifa-painel-cabecalho"><div><h2 id="rifa-mapa-titulo">Mapa de números</h2><p class="text-muted">@Model.Total números encontrados · página @Model.Pagina</p></div><div class="rifa-legenda"><span>Livre</span><span class="rifa-legenda-reservado">Reservado</span><span class="rifa-legenda-pago">Pago</span></div></div>
<form method="get" class="ui-filtros mb-6 flex flex-wrap gap-3"><input type="hidden" name="id" value="@r.Id"/><div class="form-field"><label for="busca" class="form-label">Número, comprador ou vendedor</label><input id="busca" name="busca" value="@Model.Busca" class="form-control"/></div><div class="form-field"><label for="status" class="form-label">Situação</label><select id="status" name="status" class="form-control"><option value="">Todos</option>@foreach(var s in new[]{"Livre","Reservado","Pago"}){<option selected="@(s==Model.Status)">@s</option>}</select></div><button class="btn btn-outline">Filtrar números</button></form>
<div class="rifa-numeros" aria-label="Números da rifa">
@foreach(var numero in Model.Numeros){ocupados.TryGetValue(numero,out var registro);var estado=registro is null?"livre":registro.Pago?"pago":"reservado";
<button type="button" class="rifa-numero rifa-numero-@estado" data-rifa-numero="@numero" data-rifa-estado="@estado" disabled="@(registro is null&&!aberta)" aria-label="Número @numero.ToString("D4"), @estado@(registro is null?"":", "+registro.Comprador)" aria-pressed="false">@numero.ToString("D4")<span>@(registro is null?"Livre":registro.Pago?"Pago":"Reserva")</span></button>}
</div><p class="rifa-selecao text-muted" aria-live="polite" data-rifa-selecao>Escolha os números livres para preencher a reserva.</p>
<details class="rifa-compradores" open><summary>Compradores deste intervalo <span class="badge">@Model.Numeros.Count(n=>ocupados.ContainsKey(n))</span></summary><div class="table-wrapper rifa-tabela"><table class="table"><caption class="sr-only">Números da rifa</caption><thead><tr><th>Número</th><th>Comprador</th><th>Telefone / vendedor</th><th>Situação</th><th>Ações</th></tr></thead><tbody>@foreach(var numero in Model.Numeros.Where(n=>ocupados.ContainsKey(n))){ocupados.TryGetValue(numero,out var n);<tr id="rifa-numero-@numero"><td class="font-mono">@numero.ToString("D4")</td><td>@(n?.Comprador??"Disponível")</td><td>@n?.Telefone<br/>@n?.Vendedor</td><td><span class="badge">@(n is null?"Livre":n.Pago?"Pago":"Reservado")</span></td><td>@if(n is not null){<div class="flex flex-wrap gap-2">@if(alteravel){<form method="post" asp-action="Pagamento" class="flex flex-wrap gap-2"><input type="hidden" name="id" value="@r.Id"/><input type="hidden" name="revisao" value="@r.Revisao"/><input type="hidden" name="numero" value="@numero"/><input type="hidden" name="pago" value="@((!n.Pago).ToString())"/>@if(!n.Pago){<select name="forma" class="form-control" aria-label="Forma de pagamento do número @numero">@foreach(var forma in new[]{"Dinheiro","PIX","Transferência","Cartão","Outro"}){<option>@forma</option>}</select>}<button class="btn btn-outline btn-sm">@(n.Pago?"Estornar pagamento":"Confirmar pagamento")</button></form>@if(aberta&&!n.Pago){<form method="post" asp-action="Liberar"><input type="hidden" name="id" value="@r.Id"/><input type="hidden" name="revisao" value="@r.Revisao"/><input type="hidden" name="numero" value="@numero"/><button class="btn btn-outline btn-sm">Liberar reserva</button></form>}}<a asp-action="Imprimir" asp-route-id="@r.Id" asp-route-numero="@numero" target="_blank" rel="noopener" class="btn btn-ghost btn-sm">Bilhete</a></div>}</td></tr>}</tbody></table></div>@if(!Model.Numeros.Any(n=>ocupados.ContainsKey(n))){<p class="text-muted mt-4">Nenhum comprador neste intervalo. Selecione números livres para iniciar uma reserva.</p>}</details>
@if(Model.Total==0){<p class="text-muted">Nenhum número encontrado.</p>}
<nav class="paginacao" aria-label="Paginação dos números"><p>@Model.Total números encontrados · Página @Model.Pagina</p><div class="flex gap-2">@if(Model.Pagina>1){<a asp-route-id="@r.Id" asp-route-busca="@Model.Busca" asp-route-status="@Model.Status" asp-route-pagina="@(Model.Pagina-1)" class="btn btn-outline">Anterior</a>}@if(Model.Pagina*100<Model.Total){<a asp-route-id="@r.Id" asp-route-busca="@Model.Busca" asp-route-status="@Model.Status" asp-route-pagina="@(Model.Pagina+1)" class="btn btn-outline">Próxima</a>}</div></nav>
</section></div>
@if(alteravel&&r.Resultados.Count==0){<details class="rifa-painel mt-6"><summary>Controle da rifa</summary><div class="rifa-controle"><form method="post" asp-action="Situacao" class="flex flex-wrap gap-3"><input type="hidden" name="id" value="@r.Id"/><input type="hidden" name="revisao" value="@r.Revisao"/><input type="hidden" name="situacao" value="@(aberta?"Fechada":"Aberta")"/><button class="btn btn-outline">@(aberta?"Fechar vendas":"Reabrir vendas")</button></form><form method="post" asp-action="Situacao" class="mt-4"><input type="hidden" name="id" value="@r.Id"/><input type="hidden" name="revisao" value="@r.Revisao"/><input type="hidden" name="situacao" value="Cancelada"/><label class="form-check"><input type="checkbox" name="confirmar" value="true" required/> Confirmo o cancelamento desta rifa. Os pagamentos devem estar estornados.</label><button class="btn btn-danger mt-3">Cancelar rifa</button></form></div></details>}
@if(r.Situacao=="Fechada"){<form method="post" asp-action="Resultado" class="ui-folha mt-6"><input type="hidden" name="id" value="@r.Id"/><input type="hidden" name="revisao" value="@r.Revisao"/><fieldset class="ui-formulario-secao"><legend>Registrar resultado do sorteio</legend><p class="ui-formulario-nota">Informe o resultado apurado no sorteio. Somente números pagos podem ganhar.</p><div class="grid gap-5 md:grid-cols-3"><div class="form-field"><label for="premio" class="form-label">Prêmio *</label><select id="premio" name="premio" class="form-control">@for(var i=1;i<=r.Premios.Split('\n').Length;i++){if(!r.Resultados.Any(x=>x.Premio==i)){<option value="@i">@i º — @r.Premios.Split('\n')[i-1]</option>}}</select></div><div class="form-field"><label for="numero-vencedor" class="form-label">Número vencedor *</label><input id="numero-vencedor" name="numero" type="number" min="1" max="@r.Quantidade" class="form-control" required/></div><div class="form-field"><label for="referencia" class="form-label">Referência / ata do sorteio *</label><input id="referencia" name="referencia" class="form-control" required maxlength="500"/></div></div></fieldset><label class="form-check"><input type="checkbox" name="confirmar" value="true" required/> Conferi o resultado e confirmo o registro definitivo.</label><button class="btn btn-primary mt-3">Registrar vencedor</button></form>}
