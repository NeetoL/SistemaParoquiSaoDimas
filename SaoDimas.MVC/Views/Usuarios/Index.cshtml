@model UsuariosViewModel
@{ViewData["Title"]="Usuários e permissões";ViewData["Descricao"]="Contas individuais e acesso conforme a função na paróquia.";var atual=Model.Editando;}
<section class="card mb-6"><div class="card-header"><h2 class="card-title">@(atual is null?"Criar usuário":"Editar usuário")</h2></div><form asp-action="Salvar" method="post" class="card-body"><input name="id" type="hidden" value="@atual?.Id" /><div asp-validation-summary="All" class="alerta-erro mb-4"></div><div class="grid gap-4 md:grid-cols-2"><div class="form-field"><label for="nome" class="form-label">Nome</label><input id="nome" name="nome" value="@atual?.Nome" class="form-control" required maxlength="120" /></div><div class="form-field"><label for="login" class="form-label">Login</label><input id="login" name="login" value="@atual?.Login" class="form-control" required maxlength="80" /></div><div class="form-field"><label for="perfil" class="form-label">Perfil</label><select id="perfil" name="perfil" class="form-control">@foreach(var perfil in CatalogoParoquial.Perfis){<option selected="@(atual?.Perfil==perfil)" value="@perfil">@perfil</option>}</select></div><div class="form-field"><label for="senha" class="form-label">@(atual is null?"Senha inicial":"Nova senha (opcional)")</label><input id="senha" name="senha" type="password" autocomplete="new-password" minlength="8" maxlength="128" class="form-control" required="@(atual is null)" /></div><label class="form-check"><input name="ativo" type="checkbox" value="true" checked="@(atual?.Ativo??true)" />Conta ativa</label></div><div class="flex gap-2 mt-5"><button class="btn btn-primary">Salvar usuário</button>@if(atual is not null){<a asp-action="Index" class="btn btn-outline">Cancelar edição</a>}</div></form></section>
<div class="table-wrapper"><table class="table"><thead><tr><th>Nome</th><th>Login</th><th>Perfil</th><th>Situação</th><th></th></tr></thead><tbody>@foreach(var u in Model.Usuarios){<tr><td>@u.Nome</td><td>@u.Login</td><td>@u.Perfil</td><td><span class="badge @(u.Ativo?"badge-success":"badge-neutral")">@(u.Ativo?"Ativo":"Inativo")</span></td><td><a href="/Usuarios?id=@u.Id" class="btn btn-outline btn-sm">Editar</a></td></tr>}</tbody></table></div>
<details class="card p-5 mt-6"><summary>O que cada perfil pode acessar</summary><ul class="mt-4 space-y-2 text-muted"><li>Administrador: todos os módulos, usuários, backups e auditoria.</li><li>Secretaria: dizimistas, contribuições, sacramentos, agenda, pastorais, voluntários e escalas.</li><li>Tesouraria: dizimistas, contribuições, financeiro, agenda e caixa dos eventos.</li><li>Coordenador: eventos, agenda, pastorais, voluntários e escalas.</li></ul><p class="mt-4 text-muted">Alterar o perfil, a senha ou desativar uma conta encerra os acessos antigos na próxima requisição.</p></details>
