@model IReadOnlyList<AuditoriaParoquial>
@{ViewData["Title"]="Histórico de alterações";ViewData["Descricao"]="Acessos e operações registrados por usuário.";var pagina=(int)ViewData["Pagina"]!;var total=(int)ViewData["Total"]!;}
<form method="get" class="ui-filtros p-5 mb-6 flex gap-3"><input name="busca" value="@ViewData["Busca"]" class="form-control" placeholder="Usuário, operação ou módulo…" aria-label="Pesquisar histórico" /><button class="btn btn-primary">Pesquisar</button></form>
<div class="table-wrapper"><table class="table"><thead><tr><th>Data</th><th>Usuário</th><th>Operação</th><th>Módulo</th><th>Referência</th></tr></thead><tbody>@foreach(var a in Model){<tr><td>@TimeZoneInfo.ConvertTimeFromUtc(DateTime.SpecifyKind(a.Data,DateTimeKind.Utc),TimeZoneInfo.FindSystemTimeZoneById("America/Sao_Paulo")).ToString("dd/MM/yyyy HH:mm")</td><td>@a.Operador</td><td>@a.Acao</td><td>@a.Modulo</td><td>@a.Referencia@if(a.Depois is not null){<details class="mt-2"><summary class="text-primary-700 cursor-pointer">Ver alterações</summary><dl class="mt-3">@foreach(var campo in a.Depois.Where(c=>a.Antes?.GetValueOrDefault(c.Key)!=c.Value)){<dt class="font-medium">@(CatalogoParoquial.Obter(a.Modulo)?.Campos.FirstOrDefault(c=>c.Chave==campo.Key)?.Nome??campo.Key)</dt><dd class="text-muted">@a.Antes?.GetValueOrDefault(campo.Key,"—") → @campo.Value</dd>}</dl></details>}</td></tr>}</tbody></table></div><div class="paginacao"><p>@total operação(ões) · Página @pagina</p><div class="flex gap-2">@if(pagina>1){<a href="?pagina=@(pagina-1)&busca=@Uri.EscapeDataString(ViewData["Busca"]?.ToString()??"")" class="btn btn-outline btn-sm">Anterior</a>}@if(pagina*50<total){<a href="?pagina=@(pagina+1)&busca=@Uri.EscapeDataString(ViewData["Busca"]?.ToString()??"")" class="btn btn-outline btn-sm">Próxima</a>}</div></div>
