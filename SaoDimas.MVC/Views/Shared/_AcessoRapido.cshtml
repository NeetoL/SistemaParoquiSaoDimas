<dialog id="acesso-rapido" class="modal produto-acesso" aria-labelledby="acesso-titulo">
    <div class="modal-header"><div><h2 id="acesso-titulo" class="modal-title">Onde você quer ir?</h2><p class="modal-description">Encontre uma área do sistema pelo nome.</p></div><button type="button" class="btn btn-ghost btn-icone" data-acesso-fechar aria-label="Fechar acesso rápido"><svg class="icone" aria-hidden="true"><use href="/icons/lucide.svg#x" /></svg></button></div>
    <div class="modal-body"><label class="sr-only" for="acesso-busca">Pesquisar áreas</label><input id="acesso-busca" class="form-control" type="search" placeholder="Dizimistas, agenda, contribuições…" autocomplete="off" /><nav class="produto-destinos" aria-label="Áreas disponíveis" data-acesso-lista></nav><p class="produto-acesso-vazio" data-acesso-vazio hidden>Nenhuma área encontrada. Tente outro nome.</p></div>
    <div class="produto-acesso-rodape"><span>Use Tab para navegar e Enter para abrir.</span><span><kbd>Esc</kbd> fechar</span></div>
</dialog>
