@model ImportacaoGestaoViewModel
@{ViewData["Title"]="Importar planilha";ViewData["Descricao"]="Dizimistas";}
<section class="card"><div class="card-body"><p class="mb-4 text-muted">Salve a planilha como CSV UTF-8, separado por ponto e vírgula. Até 500 registros por importação. Use o modelo para conferir as colunas; vínculos usam os identificadores dos cadastros.</p><a href="/Cadastros/Modelo" class="btn btn-outline mb-5">Baixar modelo CSV</a>@if(Model.Mensagem is not null){<p class="alerta-erro mb-5" role="status">@Model.Mensagem</p>}
@if(Model.Validada){var linhas=SaoDimas.Aplicacao.Utilitarios.CsvParoquial.Ler(Model.Csv!);<div class="table-wrapper mb-5"><table class="table"><thead><tr>@foreach(var coluna in linhas[0]){<th>@coluna</th>}</tr></thead><tbody>@foreach(var linha in linhas.Skip(1).Take(10)){<tr>@foreach(var valor in linha){<td>@valor</td>}</tr>}</tbody></table></div><p class="text-muted mb-4">Prévia dos primeiros @Math.Min(10,linhas.Count-1) registros de @(linhas.Count-1).</p><form method="post">@Html.AntiForgeryToken()<input name="confirmar" type="hidden" value="true" /><textarea name="csv" hidden>@Model.Csv</textarea><p class="mb-4">A validação terminou. Confirme para salvar os registros no sistema.</p><button class="btn btn-primary">Confirmar importação</button></form>}
else{<form method="post" enctype="multipart/form-data">@Html.AntiForgeryToken()<div class="form-field mb-5"><label for="planilha" class="form-label">Planilha CSV</label><input id="planilha" name="planilha" type="file" accept=".csv" class="form-control" required /></div><button class="btn btn-primary">Validar antes de importar</button></form>}
</div></section>
