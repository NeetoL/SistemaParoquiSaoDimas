@model RelatoriosViewModel
@using System.Security.Claims
@{ViewData["Title"]="Relatórios";ViewData["Descricao"]="Informações por módulo, comunidade e período.";var modulo=ViewData["Modulo"]?.ToString();}
<div asp-validation-summary="All" class="alerta-erro"></div><form class="ui-filtros ui-filtros grid gap-4 md:grid-cols-4" method="get"><div class="form-field"><label for="modulo" class="form-label">Módulo</label><select id="modulo" name="modulo" class="form-control">@foreach(var m in CatalogoParoquial.Modulos.Where(m=>m.Perfis.Contains(User.FindFirstValue(ClaimTypes.Role)!))){<option value="@m.Chave" selected="@(modulo==m.Chave)">@m.Nome</option>}</select></div><div class="form-field"><label for="de" class="form-label">De</label><input id="de" name="de" type="date" value="@Model.De?.ToString("yyyy-MM-dd")" class="form-control" /></div><div class="form-field"><label for="ate" class="form-label">Até</label><input id="ate" name="ate" type="date" value="@Model.Ate?.ToString("yyyy-MM-dd")" class="form-control" /></div><div class="form-field"><label for="comunidade" class="form-label">Comunidade</label><select id="comunidade" name="comunidade" class="form-control"><option value="">Todas as comunidades</option>@foreach(var c in (Dictionary<string,string>)ViewData["Comunidades"]!){<option value="@c.Key" selected="@(Model.Comunidade==c.Key)">@c.Value</option>}</select></div><button class="btn btn-primary">Consultar</button><button name="csv" value="true" class="btn btn-outline">Exportar relatório CSV</button><button name="pdf" value="true" class="btn btn-secondary">Gerar PDF</button></form>
<section class="card p-5 mt-6"><h2 class="card-title">@Model.Registros.Count registro(s) no período</h2>@if(Model.Resumo is not null){<dl class="lista-dados mt-5"><div><dt>Entradas</dt><dd>@Model.Resumo.Entradas.ToString("C")</dd></div><div><dt>Saídas</dt><dd>@Model.Resumo.Saidas.ToString("C")</dd></div><div><dt>Saldo</dt><dd>@Model.Resumo.Saldo.ToString("C")</dd></div></dl>}@if(modulo=="financeiro"){<p class="text-muted mt-5">O financeiro inclui contribuições e recebimentos/estornos dos eventos. O fundo de troco não é contado como receita.</p>}</section>
