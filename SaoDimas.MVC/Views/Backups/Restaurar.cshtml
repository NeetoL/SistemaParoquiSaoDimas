@model RestaurarBackupViewModel
@{ViewData["Title"]="Revisar restauração";}
<section class="card max-w-lg"><form method="post" class="card-body"><input name="nome" type="hidden" value="@Model.Nome" /><input name="hash" type="hidden" value="@Model.Hash" /><h2 class="card-title">@Model.Nome</h2><dl class="lista-dados mt-5 mb-5"><div><dt>Dizimistas</dt><dd>@Model.Dizimistas</dd></div><div><dt>Registros dos módulos</dt><dd>@Model.Registros</dd></div><div><dt>Edições de eventos</dt><dd>@Model.Eventos</dd></div></dl><p class="text-muted mb-5">Os cadastros e movimentos atuais serão substituídos pelo conteúdo desta cópia. Contas de acesso e auditoria atuais serão mantidas. O sistema preservará uma cópia dos dados antes da restauração.</p><div class="form-field"><label for="confirmacao" class="form-label">Digite RESTAURAR para confirmar</label><input id="confirmacao" name="confirmacao" class="form-control" required pattern="RESTAURAR" /></div><div class="flex gap-2 mt-5"><a asp-action="Index" class="btn btn-outline">Voltar</a><button class="btn btn-danger">Restaurar os dados</button></div></form></section>
