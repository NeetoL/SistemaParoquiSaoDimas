@model BackupsViewModel
@{ViewData["Title"]="Backup e recuperação";ViewData["Descricao"]="Cópias dos dados da paróquia, guardadas fora da área pública.";}
<section class="card p-5 mb-6"><p class="text-muted mb-4">O sistema guarda uma cópia automática antes da primeira alteração de cada dia e mantém os 30 últimos dias com alterações. Cópias manuais e o estado anterior a uma restauração também ficam disponíveis. Baixe uma cópia e guarde-a em outro dispositivo.</p><form asp-action="Criar" method="post"><button class="btn btn-primary">Criar e baixar backup completo</button></form><p class="form-hint mt-4">O arquivo contém dados pessoais e contas com senhas protegidas por hash. Apenas administradores podem acessá-lo.</p></section>
<section class="card p-5 mb-6"><h2 class="card-title mb-4">Recuperar uma cópia guardada em outro dispositivo</h2><form asp-action="Enviar" method="post" enctype="multipart/form-data"><div class="form-field mb-4"><label for="backup" class="form-label">Arquivo de backup JSON (até 100 MB)</label><input id="backup" name="backup" type="file" accept=".json" class="form-control" required /></div><button class="btn btn-outline">Enviar e revisar</button></form></section>
<div class="table-wrapper"><table class="table"><thead><tr><th>Arquivo</th><th>Data</th><th>Tamanho</th><th>Ações</th></tr></thead><tbody>@foreach(var b in Model.Backups){<tr><td>@b.Nome</td><td>@TimeZoneInfo.ConvertTimeFromUtc(DateTime.SpecifyKind(b.Data,DateTimeKind.Utc),TimeZoneInfo.FindSystemTimeZoneById("America/Sao_Paulo")).ToString("dd/MM/yyyy HH:mm")</td><td>@((b.Tamanho/1024m).ToString("N1")) KB</td><td><div class="flex gap-2"><a asp-action="Baixar" asp-route-nome="@b.Nome" class="btn btn-outline btn-sm">Baixar</a><a asp-action="Restaurar" asp-route-nome="@b.Nome" class="btn btn-outline btn-sm">Revisar restauração</a></div></td></tr>}@if(Model.Backups.Count==0){<tr><td colspan="4">Nenhuma cópia disponível ainda.</td></tr>}</tbody></table></div>
