@{ViewData["Title"]="Alterar senha";}
<section class="card max-w-lg"><form method="post" class="card-body grid gap-5"><div asp-validation-summary="All" class="alerta-erro"></div><div class="form-field"><label for="atual" class="form-label">Senha atual</label><input id="atual" name="atual" type="password" autocomplete="current-password" class="form-control" required /></div><div class="form-field"><label for="nova" class="form-label">Nova senha</label><input id="nova" name="nova" type="password" autocomplete="new-password" minlength="8" maxlength="128" class="form-control" required /><p class="form-hint">De 8 a 128 caracteres. Após salvar, entre novamente.</p></div><button class="btn btn-primary">Salvar nova senha</button></form></section>